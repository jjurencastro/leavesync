# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=leavesync

# Server Configuration
APP_ENV=development
APP_DEBUG=true
APP_URL=https://localhost:8443
APP_SECRET=your_app_secret_key_here

# Security
ENCRYPTION_KEY=your_encryption_key_here
JWT_SECRET=your_jwt_secret_here

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (SMTP). For Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as MAIL_PASSWORD.
# Leave MAIL_HOST/MAIL_USER blank to disable outbound email (in-app notifications still work).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=tls
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=your_email@gmail.com
MAIL_FROM_NAME=LeaveSync

# Session
SESSION_LIFETIME=3600
SESSION_SECURE=true
SESSION_HTTPONLY=true

# How long a login stays valid on an already-trusted device, sliding on activity (seconds; default 30 days)
AUTH_SESSION_LIFETIME=2592000

# Two-Factor Authentication
MFA_ENABLED=true
MFA_WINDOW=30

# API Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600
