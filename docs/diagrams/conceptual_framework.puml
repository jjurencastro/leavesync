@startuml
!pragma layout smetana
title Conceptual Framework (Input-Process-Output Model)

skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}

rectangle "INPUT\n----\nExisting (manual) leave process\n\nUser and system requirements\n\nEmployee/account data\n\nLeave information\n(type, dates, reason)\n\nLeave balance information\n\nSecurity requirements\n(MFA, device trust, signatures)\n\nApproval requirements\n(supervisor / HR hierarchy)\n\nSystem development resources\nand tools" as INPUT

rectangle "PROCESS\n----\nRequirements analysis\n\nSystem design\n\nSystem development\n(implementation)\n\nAuthentication and MFA\n\nDevice verification\n\nLeave validation\n(dates, weekdays, overlap, balance)\n\nApproval routing\n(supervisor / HR hierarchy)\n\nDigital signature verification\n(WebAuthn passkey)\n\nTesting and refinement\n\nSystem integration" as PROCESS

rectangle "OUTPUT\n----\nDeveloped LeaveSync system\n\nSecure leave submission\n\nAutomated leave validation\n\nControlled approval workflow\n\nDigitally verified approval\n\nUpdated leave balances\n\nAudit records" as OUTPUT

INPUT -down-> PROCESS
PROCESS -down-> OUTPUT
@enduml
