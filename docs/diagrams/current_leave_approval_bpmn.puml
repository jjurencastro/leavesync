@startuml
!pragma layout smetana
title BPMN Diagram of the Existing Leave Management Process

start
partition "Employee" {
  :Complete leave request form;
  :Submit leave request;
}

partition "Google Forms" {
  :Record submitted response;
  :Notify supervisor via Google account;
}

partition "Supervisor" {
  :Receive notification;
  :Review leave request;
  if (Approve request?) then (Yes)
    :Enter approved leave in HRIS;
  else (No)
    :Enter rejected leave in HRIS;
  endif
}

partition "HRIS" {
  if (Approved entry received?) then (Yes)
    :Deduct leave days from employee balance;
    :Record approved leave;
  else (No)
    :Leave balance unchanged;
    :Record rejected leave;
  endif
}
stop
@enduml
